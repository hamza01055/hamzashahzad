# Copy this file to .env.local (which git ignores) and fill in the values.
# Both are used on the server only and are never sent to the browser.

# Required for AI replies. Get a key at https://platform.claude.com/
ANTHROPIC_API_KEY=

# Optional. Where the chat assistant sends confirmed project inquiries.
# It receives a JSON POST with the inquiry fields. Works with a Formspree form
# endpoint (emails you each inquiry), or an n8n, Zapier, Make, or Slack webhook.
# Leave empty and the assistant will give visitors your contact links instead.
INQUIRY_WEBHOOK_URL=
